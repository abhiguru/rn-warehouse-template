# Copy to .env: cp .env.example .env
# Then run: npm run check:backend (checks public bootstrap only)

# =============================================================================
# Supabase Connection
# =============================================================================
# For local dev: supabase-warehouse-template Docker uses port 18000
# For physical iPhone: use scripts/ios-usb.mjs; keep a development backend off the LAN and tunnels.
EXPO_PUBLIC_CONFIG_API_URL=http://localhost:18000

# =============================================================================
# App Identity
# =============================================================================
EXPO_PUBLIC_APP_NAME=Warehouse Manager
EXPO_PUBLIC_COMPANY_NAME=Your Company Name
# The deep-link scheme is not set here. A build takes it from app.json (`warehousemanager`), or from
# WAREHOUSE_APP_SCHEME at build time (app.config.js), and the app reads it from its own
# configuration. EXPO_PUBLIC_APP_SCHEME is ignored.

# =============================================================================
# Central login (docs/CENTRAL_LOGIN.md). Off unless the origin is set.
# =============================================================================
# The association's identity service: an https:// origin. A development build
# also accepts http://localhost:PORT and http://127.0.0.1:PORT.
# Set this whenever the facility backend was set up with --central-issuer: without it the app shows
# only the single "warehouse server" screen. It is inlined when the app is bundled, so restart Metro
# with `npx expo start --clear` after changing it.
# EXPO_PUBLIC_CENTRAL_ORIGIN=https://identity.example.test
# The issuer name facilities trust (their CENTRAL_ISSUER). Defaults to the origin.
# EXPO_PUBLIC_CENTRAL_ISSUER=https://identity.example.test

# =============================================================================
# Store IDs (for force update feature)
# =============================================================================
# EXPO_PUBLIC_ANDROID_PACKAGE=com.example.warehousemanager
# EXPO_PUBLIC_IOS_APP_ID=

# =============================================================================
# Optional: Sentry/GlitchTip Error Reporting (leave empty to disable)
# Setting a DSN switches crash reports on for EVERY phone that runs the build; the
# app has no per-person switch. Before you ship such a build, check the privacy
# screen's wording and make the Apple and Google declarations:
# docs/TELEMETRY_AND_PRIVACY.md section 1 and docs/RELEASE_PREPARATION.md,
# "Crash-reporting declarations".
# =============================================================================
# EXPO_PUBLIC_SENTRY_DSN=
