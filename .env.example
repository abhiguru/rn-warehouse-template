# Copy to .env: cp .env.example .env
# Then run: npm run check:backend (checks public bootstrap only)

# =============================================================================
# Supabase Connection
# =============================================================================
# For local dev: supabase-warehouse-template Docker uses port 18000
# For physical iPhone: use scripts/ios-usb.mjs; never expose demo OTP on the LAN.
EXPO_PUBLIC_CONFIG_API_URL=http://localhost:18000

# =============================================================================
# App Identity
# =============================================================================
EXPO_PUBLIC_APP_NAME=Warehouse Manager
EXPO_PUBLIC_COMPANY_NAME=Your Company Name
EXPO_PUBLIC_APP_SCHEME=warehousemanager

# =============================================================================
# Store IDs (for force update feature)
# =============================================================================
# EXPO_PUBLIC_ANDROID_PACKAGE=com.example.warehousemanager
# EXPO_PUBLIC_IOS_APP_ID=

# =============================================================================
# Optional: Sentry/GlitchTip Error Reporting (leave empty to disable)
# =============================================================================
# EXPO_PUBLIC_SENTRY_DSN=
