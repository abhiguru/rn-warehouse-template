{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/store/*": ["./src/store/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/types/*": ["./src/types/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/services/*": ["./src/services/*"],
      "@/constants/*": ["./src/constants/*"]
    }
  },
  "exclude": ["node_modules", ".claude", "jest.setup.js", "babel.config.js", "metro.config.js", "**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"]
}
