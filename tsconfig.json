{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/components/*"],
      "@/screens/*": ["src/screens/*"],
      "@/store/*": ["src/store/*"],
      "@/utils/*": ["src/utils/*"],
      "@/types/*": ["src/types/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/services/*": ["src/services/*"],
      "@/constants/*": ["src/constants/*"]
    }
  },
  "exclude": ["node_modules", "jest.setup.js", "babel.config.js", "metro.config.js", "**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"]
}
