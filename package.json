{
  "name": "rn-warehouse-template",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || >=26.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhiguru/rn-warehouse-template.git"
  },
  "bugs": {
    "url": "https://github.com/abhiguru/rn-warehouse-template/issues"
  },
  "homepage": "https://github.com/abhiguru/rn-warehouse-template#readme",
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "node scripts/check-install.mjs",
    "start": "expo start",
    "preandroid": "node scripts/check-install.mjs",
    "android": "expo run:android",
    "preios": "node scripts/check-install.mjs",
    "ios": "expo run:ios",
    "preweb": "node scripts/check-install.mjs",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "pretest": "node scripts/check-install.mjs",
    "test": "jest --maxWorkers=50%",
    "test:setup": "node --test scripts/*.test.mjs",
    "check:backend": "node scripts/check-backend.mjs",
    "update-supabase-keys": "bash scripts/update-supabase-keys.sh",
    "doctor": "node scripts/doctor.mjs",
    "audit:artifact": "node scripts/artifact-audit.mjs",
    "postinstall": "node scripts/patch-expo-metro.mjs && node scripts/patch-security-backports.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "verify:backports": "node scripts/patch-security-backports.mjs --verify"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@reduxjs/toolkit": "^2.0.1",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "9.3.1",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.22",
    "expo-application": "~58.1.2",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.20",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-paper": "^5.14.5",
    "react-native-paper-dates": "^0.24.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.1.0",
    "redux-persist": "^6.0.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.38.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-doctor": "1.21.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "node-forge": "1.4.1",
    "postcss": "8.5.28",
    "compression": "1.8.2",
    "source-map-js": "1.2.2",
    "shell-quote": "1.11.0"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "globalSetup": "<rootDir>/jest.global-setup.js",
    "setupFiles": [
      "<rootDir>/node_modules/react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/\\.claude/",
      "<rootDir>/scripts/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/\\.claude/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@gorhom/.*|@reduxjs/toolkit|immer|@sentry/.*|@shopify/flash-list|react-navigation|@react-navigation/.*|react-native-svg|standard-navigation|@tanstack/(react-table|table-core|store|react-store)))"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-picker/picker"
      ]
    }
  }
}
