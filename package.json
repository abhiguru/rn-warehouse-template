{
  "name": "rn-warehouse-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhiguru/rn-warehouse-template.git"
  },
  "bugs": {
    "url": "https://github.com/abhiguru/rn-warehouse-template/issues"
  },
  "homepage": "https://github.com/abhiguru/rn-warehouse-template#readme",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:setup": "node --test scripts/*.test.mjs",
    "check:backend": "node scripts/check-backend.mjs",
    "update-supabase-keys": "bash scripts/update-supabase-keys.sh",
    "doctor": "node scripts/doctor.mjs",
    "audit:artifact": "node scripts/artifact-audit.mjs",
    "postinstall": "node scripts/patch-expo-metro.mjs && node scripts/patch-navigation-decoder.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@reduxjs/toolkit": "^2.0.1",
    "@sentry/react-native": "~8.27.0",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.52.0",
    "@tanstack/react-query": "^5.103.1",
    "babel-preset-expo": "~57.0.12",
    "expo": "~57.0.24",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-calendars": "^1.1313.0",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-paper": "^5.14.5",
    "react-native-paper-dates": "^0.24.0",
    "react-native-reanimated": "~4.7.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "0.13.0",
    "react-native-worklets-core": "^1.6.2",
    "react-redux": "^9.1.0",
    "redux-persist": "^6.0.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "postcss": "8.5.28",
    "xcode": {
      "uuid": "11.1.1"
    },
    "@expo/ngrok": {
      "uuid": "11.1.1"
    },
    "metro": "0.83.8",
    "metro-babel-transformer": "0.83.8",
    "metro-cache": "0.83.8",
    "metro-cache-key": "0.83.8",
    "metro-config": "0.83.8",
    "metro-core": "0.83.8",
    "metro-file-map": "0.83.8",
    "metro-minify-terser": "0.83.8",
    "metro-resolver": "0.83.8",
    "metro-runtime": "0.83.8",
    "metro-source-map": "0.83.8",
    "metro-symbolicate": "0.83.8",
    "metro-transform-plugins": "0.83.8",
    "metro-transform-worker": "0.83.8",
    "decode-uri-component": "0.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@gorhom/.*|@reduxjs/toolkit|immer|@sentry/react-native|react-navigation|@react-navigation/.*|react-native-svg|decode-uri-component))"
    ]
  }
}
