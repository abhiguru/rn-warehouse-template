{
  "name": "rn-warehouse-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhiguru/rn-warehouse-template.git"
  },
  "bugs": {
    "url": "https://github.com/abhiguru/rn-warehouse-template/issues"
  },
  "homepage": "https://github.com/abhiguru/rn-warehouse-template#readme",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:setup": "node --test scripts/*.test.mjs",
    "check:backend": "node scripts/check-backend.mjs",
    "update-supabase-keys": "bash scripts/update-supabase-keys.sh",
    "doctor": "node scripts/doctor.mjs",
    "audit:artifact": "node scripts/artifact-audit.mjs",
    "postinstall": "node scripts/patch-expo-metro.mjs && node scripts/patch-navigation-decoder.mjs && node scripts/patch-security-backports.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "verify:backports": "node scripts/patch-security-backports.mjs --verify"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@reduxjs/toolkit": "^2.0.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.52.0",
    "@tanstack/react-query": "^5.90.12",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1313.0",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-paper": "^5.14.5",
    "react-native-paper-dates": "^0.24.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "0.10.1",
    "react-native-worklets-core": "^1.6.2",
    "react-redux": "^9.1.0",
    "redux-persist": "^6.0.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-native-vector-icons": "^6.4.18",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "xcode": {
      "uuid": "11.1.1"
    },
    "decode-uri-component": "0.5.0",
    "compression": "1.8.2",
    "source-map-js": "1.2.2",
    "shell-quote": "1.11.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@gorhom/.*|@reduxjs/toolkit|immer|@sentry/react-native|react-navigation|@react-navigation/.*|react-native-svg|standard-navigation|decode-uri-component))"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-picker/picker"
      ]
    }
  }
}
